# Copia este fichero a .env y rellénalo. El fichero .env NUNCA se sube al
# repositorio: está en .gitignore y debe seguir estándolo.

# ------------------------------------------------------------------- entorno
# development o production. En production se exige HTTPS y clave de Stripe live.
KALMAN_ENV=development

# URL pública de la aplicación. Stripe redirige aquí tras el pago.
APP_URL=http://localhost:8501

# --------------------------------------------------------------- base de datos
# Cadena de conexión de Supabase. Usa el "connection pooler" en producción:
# el puerto 6543, no el 5432, porque un despliegue sin servidor abre y cierra
# conexiones constantemente y Postgres no lo aguanta.
DATABASE_URL=postgresql://usuario:contrasena@host:6543/postgres

# ------------------------------------------------------- clave criptográfica
# Clave de seudonimización. Si se pierde, los seudónimos ya emitidos dejan de
# poder relacionarse con nuevos lotes. Si se filtra, la seudonimización deja de
# proteger. Guárdala como guardarías la contraseña de la base de datos.
#
# Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KALMAN_PSEUDONYM_KEY=

# ---------------------------------------------------------------------- Stripe
# Clave secreta. sk_test_ para pruebas, sk_live_ para cobros reales.
STRIPE_SECRET_KEY=

# Secreto del webhook. Lo da Stripe al crear el endpoint en el panel.
# Sin él no se puede verificar la firma y cualquiera podría regalarse un plan.
STRIPE_WEBHOOK_SECRET=

# Identificadores de precio creados en Stripe. El importe vive en Stripe, no
# en el código, para que cambiar un precio no requiera un despliegue.
#
# Estos tres ya están creados en la cuenta de producción, en euros y con
# facturación mensual:
#   Kalman Starter    29 EUR/mes
#   Kalman Growth     99 EUR/mes
#   Kalman Scale     399 EUR/mes
STRIPE_PRICE_STARTER=price_1UDpAl2VrhLoHuYyMR6CJxpE
STRIPE_PRICE_GROWTH=price_1UDpBE2VrhLoHuYyfZhS5USA
STRIPE_PRICE_SCALE=price_1UDpBZ2VrhLoHuYy4heZHflc

# -------------------------------------------------------------------- soporte
SUPPORT_EMAIL=soporte@ejemplo.com

# --------------------------------------------------------------------- límites
MAX_UPLOAD_MB=50
SESSION_TTL_HOURS=12
